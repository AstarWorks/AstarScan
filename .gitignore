# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
# Note: `dist` (no trailing slash) also matches symlinks — Nuxt auto-creates
# apps/web/dist as a symlink to .output/public, which must not be committed.
dist
build
.nuxt
.output
*.tsbuildinfo

# Bun — bun.lock is committed (CI needs it to detect Bun as package manager)

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# IDE & AI tools
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/
.playwright-mcp/

# Cloudflare
.wrangler/
wrangler.toml.bak

# OCR models (147MB total — too large for git, downloaded separately)
# Run `scripts/download-ocr-models.sh` to fetch them.
apps/web/public/models/ocr/*.onnx

# SigLIP vision model (~55MB — downloaded separately for visual dedup)
# Run `scripts/download-siglip-model.sh` to fetch it.
apps/web/public/models/siglip-*.onnx

# Document corner detector (apps/web/public/models/doc-corners.onnx) is
# committed so every deploy and preview ships it; retrain per
# docs/training-doc-corners.md to replace it.

# Corner labeler outputs (scripts/label). annotations.json is the
# source-of-truth labeling effort and SHOULD be committed; everything
# below is regenerated from it by build-dataset.mjs.
scripts/dataset/labels/
scripts/dataset/yolo/
scripts/dataset/doc-corners-dataset.*

# DocAligner ONNX models (legacy failed experiment, kept locally for
# reference but never tracked).
apps/web/public/models/docaligner-*.onnx

# OpenCV.js (7.6MB — downloaded via scripts)
apps/web/public/opencv.js

# CJK font (9MB — fetched at runtime from /fonts/)
apps/web/public/fonts/*.ttf

# Test videos (too large for git)
*.mp4
*.mov
# …except the small synthetic eval clips (≤ 8 MB each, see scripts/eval/book-clips/README.md)
!scripts/eval/book-clips/clips/*.mp4

# Tauri
src-tauri/target/
src-tauri/gen/android/
src-tauri/gen/apple/

# Temporary
tmp/
temp/
*.tmp

# Eval harness outputs and Python venv for OCR backends
eval-out/
.venv-yomitoku/

# Smart-extractor scratch / archived raw frames
scripts/dataset/raw_orig*/
scripts/dataset/frames/
scripts/dataset/scene-reps.json

# External datasets (SmartDoc etc.) — downloaded, not committed
scripts/dataset/external/
apps/web/public/ort/
